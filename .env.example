PORT=3000
DATABASE_URL=postgres://user:pass@host/db?sslmode=require
JWT_SECRET=change-me
KAFKA_BROKER=kafka-xxxx.aivencloud.com:12345
# Agar Aiven mein SASL ho to ye do bharo, warna khali chhor do (client certificate use hoga)
KAFKA_USER=
KAFKA_PASS=
KAFKA_SASL_MECHANISM=scram-sha-256
# Render par certs file ki jagah poora PEM text in teen mein paste karo (optional)
KAFKA_CA=
KAFKA_CERT=
KAFKA_KEY=
# true = consumer API ke saath hi chalega (free Render ke liye)
RUN_CONSUMER=false
# Vercel invoice function URL (optional)
INVOICE_URL=
